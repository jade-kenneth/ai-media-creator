# Copy this file to ".env" (same folder) and fill in your key. NEVER commit .env.
# Get a key from https://opencode.ai/auth  ->  create an OpenCode Zen API key.

OPENCODE_ZEN_API_KEY=

# Optional overrides:
# OPENCODE_ZEN_MODEL=grok-code              # any model your Zen key can use (https://opencode.ai/zen)
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# PORT=8788                                 # if you change this, update PLA_TUTOR_URL in index.html
