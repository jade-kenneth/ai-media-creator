{
  "name": "@app/boilerplate",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "web": "nx run app-web:dev",
    "mobile": "nx run app-mobile:start",
    "api": "nx run app-api:start:dev",
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "sync-skills": "node scripts/sync-skills.mjs sync",
    "update-skills": "node scripts/sync-skills.mjs update",
    "check-skills": "node scripts/sync-skills.mjs check",
    "skills:contribution:validate": "node scripts/skill-contribution.mjs validate",
    "skills:contribution:render": "node scripts/skill-contribution.mjs render",
    "test:skill-contribution": "node scripts/test-skill-contribution.mjs",
    "design:validate": "node scripts/validate-design-export.mjs",
    "design:validate-final": "node scripts/validate-design-export.mjs --allow-synced",
    "design:validate-ci": "node scripts/validate-design-export.mjs --accept-acknowledged",
    "design:ack": "node scripts/acknowledge-design-release.mjs",
    "test:design-handoff": "node scripts/test-design-handoff.mjs",
    "boilerplate:setup": "node scripts/boilerplate-sync.mjs setup",
    "boilerplate:check": "node scripts/boilerplate-sync.mjs check",
    "boilerplate:port": "node scripts/boilerplate-sync.mjs port",
    "boilerplate:ack": "node scripts/boilerplate-sync.mjs acknowledge",
    "boilerplate:contribute": "node scripts/boilerplate-sync.mjs contribute",
    "boilerplate:foundation-drift": "node scripts/boilerplate-sync.mjs foundation-drift",
    "boilerplate:contributions": "node scripts/check-boilerplate-contributions.mjs",
    "test:sync-automation": "node scripts/test-sync-automation.mjs",
    "postinstall": "node scripts/sync-skills.mjs hydrate || echo '⚠ locked skills hydration failed (offline?) — run npm run sync-skills before agent work'",
    "project:init": "node scripts/project-init.mjs",
    "test:project-init": "node scripts/test-project-init.mjs"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nx/eslint": "22.7.6",
    "@nx/eslint-plugin": "22.7.6",
    "@nx/expo": "22.7.6",
    "@nx/js": "22.7.6",
    "@nx/next": "22.7.6",
    "@nx/webpack": "22.7.6",
    "@swc/core": "^1.15.43",
    "eslint": "^9.8.0",
    "nx": "22.7.6",
    "shadcn": "^4.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
