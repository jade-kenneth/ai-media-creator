# Copy this file to `.env` and replace every production value.

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/app-db

# Auth and bootstrap accounts
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Server and browser security
PORT=3001
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:4302,http://127.0.0.1:4302,http://localhost:8081,http://127.0.0.1:8081
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Role,Environment
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE_SECONDS=86400
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# Request logging
REQUEST_LOGGING_ENABLED=true
REQUEST_LOGGING_INCLUDE_HEALTH=false
SLOW_REQUEST_WARN_THRESHOLD_MS=1000

# AWS S3 uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=App Boilerplate

# Expo push notifications and scheduled delivery
EXPO_PUSH_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=
SCHEDULER_ENABLED=true

# Cloudflare Turnstile bot protection (skipped entirely while disabled)
TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google sign-in — every OAuth client id allowed to mint ID tokens for this API
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_IDS=

# Xendit payments
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENTS_CURRENCY=PHP
PAYMENTS_COUNTRY=PH
PAYMENTS_SUCCESS_RETURN_URL=http://localhost:4302/payments/success
PAYMENTS_FAILURE_RETURN_URL=http://localhost:4302/payments/failed

# Optional Kafka event bus
KAFKA_URL=localhost:9092
KAFKA_USERNAME=kafka
KAFKA_PASSWORD=change-me
