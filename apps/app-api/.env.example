NODE_ENV=development
PORT=3001
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/ai-creation-platform

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

SCHEDULER_ENABLED=true

CORS_ORIGINS=http://localhost:4302,http://127.0.0.1:4302
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE_SECONDS=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_LOGGING_ENABLED=true
REQUEST_LOGGING_INCLUDE_HEALTH=false
SLOW_REQUEST_WARN_THRESHOLD_MS=1000
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Application

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Cloudflare Turnstile bot protection.
# While TURNSTILE_ENABLED is false the challenge is skipped entirely — turn it
# on in every deployed environment, not just production. NODE_ENV=development
# always skips it, so never deploy with that NODE_ENV.
TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google sign-in. List every OAuth client id that may mint ID tokens for this
# API (web); a token issued for any other client is rejected.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_IDS=

# Text writing provider (hooks, scripts, angles). Configure OpenAI, Anthropic,
# DeepSeek, or several; keys stay server-side. With none, writing jobs fail
# with "The writing service isn't set up yet."
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 when blank.
ANTHROPIC_TEXT_MODEL=
DEEPSEEK_API_KEY=
# Defaults to deepseek-v4-pro when blank.
DEEPSEEK_TEXT_MODEL=
MINIMAX_TEXT_API_KEY=
# Defaults to MiniMax-M3 when blank. Use a Token Plan Subscription Key above,
# not the separate pay-as-you-go MINIMAX_API_KEY used by video.
MINIMAX_TEXT_MODEL=
# openai | anthropic | deepseek | minimax. Picks the provider when several are
# configured; blank uses the first configured provider.
TEXT_PROVIDER=
# Ordered comma-separated fallbacks (for example deepseek,minimax). Each takes
# over after an eligible failure. A request a provider declined is not retried.
TEXT_FALLBACK_PROVIDERS=
# Legacy one-provider fallback; ignored when TEXT_FALLBACK_PROVIDERS is set.
TEXT_FALLBACK_PROVIDER=

# Credits granted to a creator's first sign-in (open decision 12).
STARTER_CREDITS=50

# Hosts product import may read public product metadata from, comma separated
# (e.g. shop.example). Empty disables import; manual entry always works.
PRODUCT_IMPORT_ALLOWED_HOSTS=

# Video beta (Batch 2). Shows the Media, Voice, Edit & preview and Export steps.
VIDEO_BETA_ENABLED=false

# Voice provider (ElevenLabs), server-side only. With a key set, a model id and
# a comma-separated allowlist of up to 6 voice ids are required. Without a key,
# voice jobs fail with "The voice service isn't set up yet."
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_IDS=

# AI scene clips (MiniMax image-to-video), server-side only. Shown only when
# VIDEO_BETA_ENABLED and AI_CLIPS_ENABLED are true and a key is set. Keep it
# off in shared environments until the MiniMax terms review (open 19) closes.
AI_CLIPS_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=

# Media worker (pnpm worker): FFmpeg and ffprobe binaries, blank = on PATH.
# FFmpeg needs libx264, libass and freetype (drawtext); the worker refuses to
# start without them. RENDER_TMP_DIR defaults to the OS temp directory.
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_TMP_DIR=

# Demo seed (pnpm --filter app-api seed:demo): the Google account email that
# will own the demo projects. Sign in with that Google account afterwards.
SEED_OWNER_EMAIL=
