NODE_ENV=development
PORT=3001
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017/app-api

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

EXPO_PUSH_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=
SCHEDULER_ENABLED=true

CORS_ORIGINS=http://localhost:4302,http://127.0.0.1:4302,http://localhost:8081,http://127.0.0.1:8081
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE_SECONDS=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_LOGGING_ENABLED=true
REQUEST_LOGGING_INCLUDE_HEALTH=false
SLOW_REQUEST_WARN_THRESHOLD_MS=1000
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Application

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Cloudflare Turnstile bot protection.
# While TURNSTILE_ENABLED is false the challenge is skipped entirely — turn it
# on in every deployed environment, not just production.
TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google sign-in. List every OAuth client id that may mint ID tokens for this
# API (web, iOS, Android); a token issued for any other client is rejected.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_IDS=

# Xendit payments. The callback token is the shared secret Xendit sends on
# every webhook — set it in the Xendit dashboard and here.
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMENTS_CURRENCY=PHP
PAYMENTS_COUNTRY=PH
PAYMENTS_SUCCESS_RETURN_URL=http://localhost:4302/payments/success
PAYMENTS_FAILURE_RETURN_URL=http://localhost:4302/payments/failed
