NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Application
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
# Set this to the hostname used by public S3 object URLs (without https://).
NEXT_PUBLIC_S3_HOSTNAME=your-bucket.s3.your-region.amazonaws.com

# Cloudflare Turnstile site key. Ignored under `next dev` (the API also skips
# the check in development). Leave blank to hide the challenge elsewhere; the
# API must then have TURNSTILE_ENABLED=false or every sign-in will be rejected.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Google OAuth web client id. Must be listed in the API's
# GOOGLE_OAUTH_CLIENT_IDS. Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
