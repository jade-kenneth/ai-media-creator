# Mobile app environment. Copy to `.env` for local development.
# Point these at your running app-api instance.
EXPO_PUBLIC_API_URL=http://localhost:3001/graphql
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_ROUTER_APP_ROOT=

# Google sign-in. Create one OAuth client per platform in Google Cloud and add
# every id here to the API's GOOGLE_OAUTH_CLIENT_IDS. Leave all three blank to
# hide the Google button.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
