{
  "name": "app-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "dev:client": "npx expo start --dev-client",
    "dev:tunnel": "npx expo start --tunnel --clear",
    "dev:tunnel:debug": "EXPO_DEBUG=1 npx expo start --tunnel --clear",
    "dev:android": "npx expo run:android",
    "dev:ios": "npx expo run:ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "build:dev:android": "eas build --profile development --platform android",
    "build:local:android": "eas build --profile development --platform android --local",
    "build:local:preview:android": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk eas build -p android --profile preview --local --clear-cache",
    "build:prod:preview:android": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk eas build -p android --profile production --local --clear-cache",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "codegen": "graphql-codegen --config codegen.ts --project app-mobile",
    "codegen:watch": "graphql-codegen --watch --config codegen.ts --project app-mobile"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.97.0",
    "axios": "^1.15.0",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.45.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "^55.0.14",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "i18next": "^26.3.1",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "string-strip-html": "^13.5.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
